@prefix : <http://w3id.org/ZorroOntology/> .
@prefix default1: <http://www.semanticweb.org/ontologies/2026/ZorroDemo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:PartOf a owl:ObjectProperty ;
    rdfs:domain :Part ;
    rdfs:range :Assembly .

:defines a owl:ObjectProperty ;
    rdfs:domain :Function ;
    rdfs:range :Problem .

:dependsOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain :Function ;
    rdfs:range :Function .

:failsVia a owl:ObjectProperty ;
    rdfs:domain :Component ;
    rdfs:range :Problem .

:hasCause a owl:ObjectProperty ;
    rdfs:domain :Problem ;
    rdfs:range :Cause .

:hasEffect a owl:ObjectProperty ;
    rdfs:domain :Cause ;
    rdfs:range :Effect .

:hasFunction a owl:ObjectProperty ;
    rdfs:domain :Component ;
    rdfs:range :Function .

:inSystem a owl:ObjectProperty ;
    rdfs:domain :Assembly ;
    rdfs:range :System .

:involves a owl:ObjectProperty ;
    rdfs:domain :Problem ;
    rdfs:range :Part .

:solves a owl:ObjectProperty ;
    rdfs:domain <hhttp://w3id.org/ZorroOntology/Solution> ;
    rdfs:range :Problem .

default1: a owl:Ontology ;
    owl:imports : .

default1:hasFunctionDescription a owl:DatatypeProperty ;
    rdfs:domain :Function ;
    rdfs:range xsd:string .

default1:hasPartSpecification a owl:ObjectProperty ;
    rdfs:domain :Part ;
    rdfs:range default1:PartSpecification .

default1:hasPartType a owl:ObjectProperty ;
    rdfs:domain :Part ;
    rdfs:range default1:PartType .

default1:hasSolution a owl:ObjectProperty ;
    rdfs:domain :Cause ;
    rdfs:range :Solution .

default1:inSubsystem a owl:ObjectProperty ;
    rdfs:domain :Assembly ;
    rdfs:range default1:SubSystem .

default1:partTypeInvolvedInFunc a owl:ObjectProperty ;
    rdfs:domain :Function ;
    rdfs:range default1:PartType .

: a owl:Ontology .

:System a owl:Class ;
    rdfs:subClassOf :Component .

default1:PartSpecification a owl:Class .

default1:SubSystem a owl:Class .

default1:PartType a owl:Class .

:Assembly a owl:Class ;
    rdfs:subClassOf :Component .

:Effect a owl:Class ;
    rdfs:comment "Effect is also a problem" ;
    owl:disjointWith :Component,
        :Function,
        :Solution .

:Part a owl:Class ;
    rdfs:subClassOf :Component .

:Cause a owl:Class ;
    rdfs:comment "Cause itself  is a problem" ;
    owl:disjointWith :Component,
        :Function,
        :Solution .

:Solution a owl:Class ;
    rdfs:comment "Solution solves the cause of the problem" ;
    owl:disjointWith :Cause,
        :Component,
        :Effect,
        :Function,
        :Problem .

:Problem a owl:Class ;
    owl:disjointWith :Component,
        :Function,
        :Solution .

:Component a owl:Class ;
    rdfs:comment "A component can have one or more functions" ;
    owl:disjointWith :Cause,
        :Effect,
        :Function,
        :Problem,
        :Solution .

:Function a owl:Class ;
    rdfs:comment "A function can be performed by one or several componenets" ;
    owl:disjointWith :Cause,
        :Component,
        :Effect,
        :Problem,
        :Solution .

