@prefix : <http://www.semanticweb.org/ydo840/ontologies/2025/1/ZorroOntology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Control a :SubSystem ;
    :hasBuildingBlock :Control_System_%28Turck_PLC_Setup%29 .

:Handling a :SubSystem ;
    :hasBuildingBlock :XYZ_Robot_%28VGR%29 .

:Processing a :SubSystem ;
    :hasBuildingBlock :Processing_Station_%28MPO%29 .

:RFID_Station a :BuildingBlock ;
    :hasFunction :Read_workpiece_data .

:Robot_%28XYZ%29 a :BuildingBlock ;
    :hasFunction :Move_to_warehouse,
        :Pick_from_sorting_line,
        :Pick_up_from_RFID,
        :Pick_up_workpiece,
        :Place_in_warehouse_input,
        :Place_on_MPO_input,
        :Place_workpiece_on_RFID,
        :Transport_to_RFID_station,
        :Transport_to_processing_station_MPO,
        :Transport_to_warehouse .

:Sorting a :SubSystem ;
    :hasBuildingBlock :Sorting_Line_%28SLD%29 .

:Storage a :SubSystem ;
    :hasBuildingBlock :Warehouse_%28HBW%29 .

