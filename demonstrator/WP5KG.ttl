    demo:inSubsystem demo:Handling .

demo:COMPRESSOR a demo:PartType .

demo:LIGHT_SENSOR a demo:PartType .

demo:Processing_Station_%28MPO%29 a zorro:Assembly ;
    zorro:hasFunction demo:Detect_workpiece,
        demo:Eject_workpiece,
        demo:Feed_into_oven,
        demo:Machine_workpiece,
        demo:Process_workpiece,
        demo:Remove_from_oven,
        demo:Rotate_workpiece,
        demo:Transfer_to_turntable,
        demo:Transport_to_output ;
    demo:inSubsystem demo:Processing .

demo:Sorting_Line_%28SLD%29 a zorro:Assembly ;
    zorro:hasFunction demo:Detect_color,
        demo:Detect_incoming_workpiece,
        demo:Move_along_conveyor,
        demo:Sort_workpiece,
        demo:Store_in_bin ;
    demo:inSubsystem demo:Sorting .

demo:Warehouse_%28HBW%29 a zorro:Assembly ;
    zorro:hasFunction demo:Move_conveyor_to_pickup_position,
        demo:Move_conveyor_to_storage_position,
        demo:Select_carrier,
        demo:Store_workpiece ;
    demo:inSubsystem demo:Storage .

