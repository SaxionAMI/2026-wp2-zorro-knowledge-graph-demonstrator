    :hasFunctionDescription "Feeder pushes workpiece out of oven" ;
    :partTypeInvolvedInFunc :COMPRESSOR,
        :CYLINDER,
        :SOLENOID_VALVE .

:Rotate_workpiece a :Function ;
    :hasFunctionDescription "Turntable rotates to correct machining position" ;
