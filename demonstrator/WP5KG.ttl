@prefix demo: <http://www.semanticweb.org/ontologies/2026/ZorroDemo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zorro: <http://w3id.org/ZorroOntology/> .

zorro:PartOf a owl:ObjectProperty ;
    rdfs:domain zorro:Part ;
    rdfs:range zorro:Assembly .

zorro:defines a owl:ObjectProperty ;
    rdfs:domain zorro:Function ;
    rdfs:range zorro:Problem .

zorro:dependsOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain zorro:Function ;
    rdfs:range zorro:Function .

zorro:failsVia a owl:ObjectProperty ;
    rdfs:domain zorro:Component ;
    rdfs:range zorro:Problem .

zorro:hasCause a owl:ObjectProperty ;
    rdfs:domain zorro:Problem ;
    rdfs:range zorro:Cause .

zorro:hasEffect a owl:ObjectProperty ;
    rdfs:domain zorro:Cause ;
    rdfs:range zorro:Effect .

zorro:hasFunction a owl:ObjectProperty ;
    rdfs:domain zorro:Component ;
    rdfs:range zorro:Function .

zorro:inSystem a owl:ObjectProperty ;
    rdfs:domain zorro:Assembly ;
    rdfs:range zorro:System .

zorro:involves a owl:ObjectProperty ;
    rdfs:domain zorro:Problem ;
    rdfs:range zorro:Part .

zorro:solves a owl:ObjectProperty ;
    rdfs:domain <hhttp://w3id.org/ZorroOntology/Solution> ;
    rdfs:range zorro:Problem .

demo: a owl:Ontology ;
    owl:imports zorro: .

