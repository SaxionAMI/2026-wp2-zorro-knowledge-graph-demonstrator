:Select_carrier a :Function ;
    :hasFunctionDescription "Warehouse positions itself using motors and encoders to select the correct carrier location" ;
    :partTypeInvolvedInFunc :ENCODER,
        :MINI_MOTOR,
        :REFERENCE_SWITCH .

:Sort_workpiece a :Function ;
    :hasFunctionDescription "Pneumatic ejector directs workpiece to correct bin" ;
    :partTypeInvolvedInFunc :COMPRESSOR,
        :CYLINDER,
        :SOLENOID_VALVE .

:Sorting_Line_%28SLD%29 a :BuildingBlock ;
    :hasFunction :Detect_color,
        :Detect_incoming_workpiece,
        :Move_along_conveyor,
        :Sort_workpiece,
        :Store_in_bin ;
    :hasPart :SLD-BLUE-LB,
        :SLD-COLOR-SENSOR,
        :SLD-COMP,
        :SLD-CONVEYOR,
        :SLD-EJECT-B,
        :SLD-EJECT-R,
        :SLD-EJECT-W,
        :SLD-IN-LB,
        :SLD-MOTOR,
        :SLD-OUT-LB,
        :SLD-RED-LB,
        :SLD-VALVE-B,
        :SLD-VALVE-R,
        :SLD-VALVE-W,
        :SLD-WHITE-LB .

:Sorting_conveyor_belt a :PartSpecification .

:Store_in_bin a :Function ;
    :hasFunctionDescription "Light sensor verifies bin occupancy" ;
    :partTypeInvolvedInFunc :LIGHT_SENSOR .

:Store_workpiece a :Function ;
    :hasFunctionDescription "Warehouse positions and stores workpiece in correct location" ;
    :partTypeInvolvedInFunc :ENCODER,
        :MINI_MOTOR,
        :REFERENCE_SWITCH .

