demo:hasFunctionDescription a owl:DatatypeProperty ;
    rdfs:domain zorro:Function ;
    rdfs:range xsd:string .

demo:hasPartSpecification a owl:ObjectProperty ;
    rdfs:domain zorro:Part ;
    rdfs:range demo:PartSpecification .

demo:hasPartType a owl:ObjectProperty ;
    rdfs:domain zorro:Part ;
    rdfs:range demo:PartType .

demo:hasSolution a owl:ObjectProperty ;
    rdfs:domain zorro:Cause ;
    rdfs:range zorro:Solution .

demo:inSubsystem a owl:ObjectProperty ;
    rdfs:domain zorro:Assembly ;
    rdfs:range demo:SubSystem .

demo:partTypeInvolvedInFunc a owl:ObjectProperty ;
    rdfs:domain zorro:Function ;
    rdfs:range demo:PartType .

zorro: a owl:Ontology .

zorro:System a owl:Class ;
    rdfs:subClassOf zorro:Component .

demo:24V_DC_power_system a demo:PartSpecification .

demo:ALL_SYSTEMS a demo:PartType .

<http://www.semanticweb.org/ontologies/2026/ZorroDemo/Analog_I/O_module> a demo:PartSpecification .

demo:Backward_conveyor_mini_motor a demo:PartSpecification .

demo:Blue_bin_detection_sensor a demo:PartSpecification .

demo:Blue_ejector_cylinder a demo:PartSpecification .

demo:Blue_ejector_valve a demo:PartSpecification .

demo:Cantilever_back_switch a demo:PartSpecification .

demo:Cantilever_backward_motor a demo:PartSpecification .

demo:Cantilever_forward_motor a demo:PartSpecification .

demo:Cantilever_front_switch a demo:PartSpecification .

demo:Control a zorro:SubSystem .

demo:Cycle_complete a zorro:Function ;
    demo:hasFunctionDescription "System returns to idle state and is ready for next cycle" ;
    demo:partTypeInvolvedInFunc demo:ALL_SYSTEMS .

demo:Detect_color a zorro:Function ;
    demo:hasFunctionDescription "Color sensor determines workpiece color" ;
    demo:partTypeInvolvedInFunc demo:COLOR_SENSOR .

demo:Detect_incoming_workpiece a zorro:Function ;
    demo:hasFunctionDescription "Entry light sensor detects arrival of workpiece" ;
    demo:partTypeInvolvedInFunc demo:LIGHT_SENSOR .

demo:Detect_workpiece a zorro:Function ;
    demo:hasFunctionDescription "Light sensor confirms presence of workpiece at entry" ;
    demo:partTypeInvolvedInFunc demo:LIGHT_SENSOR .

<http://www.semanticweb.org/ontologies/2026/ZorroDemo/Digital_I/O_module> a demo:PartSpecification .

demo:Eject_workpiece a zorro:Function ;
    demo:hasFunctionDescription "Pneumatic ejector pushes workpiece onto conveyor" ;
    demo:partTypeInvolvedInFunc demo:COMPRESSOR,
        demo:CYLINDER,
        demo:SOLENOID_VALVE .

demo:Feed_into_oven a zorro:Function ;
    demo:hasFunctionDescription "Feeder pushes workpiece into oven and door closes using pneumatic system" ;
    demo:partTypeInvolvedInFunc demo:COMPRESSOR,
        demo:CYLINDER,
        demo:SOLENOID_VALVE .

demo:Forward_conveyor_mini_motor a demo:PartSpecification .

demo:Furnace_unit a demo:PartSpecification .

demo:HMI a demo:PartType .

demo:Handling a zorro:SubSystem .

demo:Horizontal_encoder_motor a demo:PartSpecification .

demo:Horizontal_movement_motor a demo:PartSpecification .

demo:Horizontal_position_encoder a demo:PartSpecification .

demo:Indexing_turntable a demo:PartSpecification .

demo:Industrial_Ethernet_switch a demo:PartSpecification .

demo:Input_light_barrier a demo:PartSpecification .

demo:Inside_light_barrier a demo:PartSpecification .

demo:Machine_workpiece a zorro:Function ;
    demo:hasFunctionDescription "Saw or milling operation is performed" ;
    demo:partTypeInvolvedInFunc demo:MINI_MOTOR .

demo:Main_industrial_controller a demo:PartSpecification .

demo:Move_along_conveyor a zorro:Function ;
    demo:hasFunctionDescription "Workpiece is transported through sorting section" ;
    demo:partTypeInvolvedInFunc demo:CONVEYOR,
        demo:MINI_MOTOR .

demo:Move_conveyor_to_pickup_position a zorro:Function ;
    demo:hasFunctionDescription "Conveyor belt moves carrier to output position where it can be picked up" ;
    demo:partTypeInvolvedInFunc demo:CONVEYOR,
        demo:LIGHT_SENSOR,
        demo:MINI_MOTOR .

demo:Move_conveyor_to_storage_position a zorro:Function ;
    demo:hasFunctionDescription "Conveyor transports workpiece into warehouse system" ;
    demo:partTypeInvolvedInFunc demo:CONVEYOR,
        demo:LIGHT_SENSOR,
        demo:MINI_MOTOR .

demo:Move_to_warehouse a zorro:Function ;
    demo:hasFunctionDescription "Robot moves to warehouse pickup position" ;
    demo:partTypeInvolvedInFunc demo:ENCODER_MOTOR,
        demo:REFERENCE_SWITCH .

demo:Operator_interface a demo:PartSpecification .

demo:Optical_color_sensor a demo:PartSpecification .

demo:Output_light_barrier a demo:PartSpecification .

demo:Outside_light_barrier a demo:PartSpecification .

demo:Oven_door_valve a demo:PartSpecification .

demo:Oven_feeder_inside_cylinder a demo:PartSpecification .

demo:Oven_feeder_outside_cylinder a demo:PartSpecification .

demo:Oven_presence_sensor a demo:PartSpecification .

demo:PLC a demo:PartType .

demo:POWER_SUPPLY a demo:PartType .

demo:Pick_from_sorting_line a zorro:Function ;
    demo:hasFunctionDescription "Robot grips processed workpiece from sorting output" ;
    demo:partTypeInvolvedInFunc demo:COMPRESSOR,
        demo:CYLINDER,
        demo:SOLENOID_VALVE,
        demo:SUCTION_CUP .

demo:Pick_up_from_RFID a zorro:Function ;
    demo:hasFunctionDescription "Vacuum system grips workpiece again" ;
    demo:partTypeInvolvedInFunc demo:COMPRESSOR,
        demo:CYLINDER,
        demo:SOLENOID_VALVE,
        demo:SUCTION_CUP .

demo:Pick_up_workpiece a zorro:Function ;
    demo:hasFunctionDescription "Vacuum system activates and grips workpiece from carrier" ;
    demo:partTypeInvolvedInFunc demo:COMPRESSOR,
        demo:CYLINDER,
        demo:SOLENOID_VALVE,
        demo:SUCTION_CUP .

demo:Place_in_warehouse_input a zorro:Function ;
    demo:hasFunctionDescription "Workpiece is placed at warehouse entry point" ;
    demo:partTypeInvolvedInFunc demo:COMPRESSOR,
        demo:CYLINDER,
        demo:SOLENOID_VALVE,
        demo:SUCTION_CUP .

demo:Place_on_MPO_input a zorro:Function ;
    demo:hasFunctionDescription "Workpiece is placed onto MPO conveyor or feeder" ;
    demo:partTypeInvolvedInFunc demo:COMPRESSOR,
        demo:CYLINDER,
        demo:SOLENOID_VALVE,
        demo:SUCTION_CUP .

demo:Place_workpiece_on_RFID a zorro:Function ;
    demo:hasFunctionDescription "Vacuum is released and workpiece is placed on RFID platform" ;
    demo:partTypeInvolvedInFunc demo:COMPRESSOR,
        demo:CYLINDER,
        demo:SOLENOID_VALVE,
        demo:SUCTION_CUP .

demo:Pneumatic_vacuum_supply a demo:PartSpecification .

demo:Process_workpiece a zorro:Function ;
