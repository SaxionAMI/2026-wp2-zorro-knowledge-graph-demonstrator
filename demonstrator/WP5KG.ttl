:Oven_feeder_inside_cylinder a :PartSpecification .

:Oven_feeder_outside_cylinder a :PartSpecification .

:Oven_presence_sensor a :PartSpecification .

:PLC a :PartType .

:PLC-NET a :Part ;
    :hasPartSpecification :Industrial_Ethernet_switch ;
    :hasPartType :SWITCH .

:PLC-TURCK a :Part ;
    :hasPartSpecification :Main_industrial_controller ;
    :hasPartType :PLC .

:POWER-24V a :Part ;
    :hasPartSpecification :24V_DC_power_system ;
    :hasPartType :POWER_SUPPLY .

:POWER_SUPPLY a :PartType .

:Pick_from_sorting_line a :Function ;
    :hasFunctionDescription "Robot grips processed workpiece from sorting output" ;
    :partTypeInvolvedInFunc :COMPRESSOR,
        :CYLINDER,
        :SOLENOID_VALVE,
        :SUCTION_CUP .

:Pick_up_from_RFID a :Function ;
    :hasFunctionDescription "Vacuum system grips workpiece again" ;
    :partTypeInvolvedInFunc :COMPRESSOR,
        :CYLINDER,
        :SOLENOID_VALVE,
        :SUCTION_CUP .

:Pick_up_workpiece a :Function ;
    :hasFunctionDescription "Vacuum system activates and grips workpiece from carrier" ;
    :partTypeInvolvedInFunc :COMPRESSOR,
        :CYLINDER,
        :SOLENOID_VALVE,
        :SUCTION_CUP .

:Place_in_warehouse_input a :Function ;
    :hasFunctionDescription "Workpiece is placed at warehouse entry point" ;
    :partTypeInvolvedInFunc :COMPRESSOR,
        :CYLINDER,
        :SOLENOID_VALVE,
        :SUCTION_CUP .

:Place_on_MPO_input a :Function ;
    :hasFunctionDescription "Workpiece is placed onto MPO conveyor or feeder" ;
    :partTypeInvolvedInFunc :COMPRESSOR,
        :CYLINDER,
        :SOLENOID_VALVE,
        :SUCTION_CUP .

:Place_workpiece_on_RFID a :Function ;
    :hasFunctionDescription "Vacuum is released and workpiece is placed on RFID platform" ;
    :partTypeInvolvedInFunc :COMPRESSOR,
        :CYLINDER,
        :SOLENOID_VALVE,
        :SUCTION_CUP .

:Pneumatic_vacuum_supply a :PartSpecification .

:Process_workpiece a :Function ;
    :hasFunctionDescription "Workpiece undergoes heating simulation indicated by red LED" ;
    :partTypeInvolvedInFunc :KILN .

:Processing_Station_%28MPO%29 a :BuildingBlock ;
    :hasFunction :Detect_workpiece,
        :Eject_workpiece,
        :Feed_into_oven,
        :Machine_workpiece,
        :Process_workpiece,
        :Remove_from_oven,
        :Rotate_workpiece,
        :Transfer_to_turntable,
        :Transport_to_output ;
    :hasPart :MPO-COMP,
        :MPO-CONV-MOTOR,
        :MPO-CONVEYOR,
        :MPO-EJECTOR,
        :MPO-FEEDER-IN,
        :MPO-FEEDER-OUT,
        :MPO-LIGHT-BARRIER,
        :MPO-OVEN,
        :MPO-OVEN-DOOR,
        :MPO-OVEN-SENSOR,
        :MPO-SAWWHEEL,
        :MPO-SUCTION,
        :MPO-TT-MOTOR,
        :MPO-TURNTABLE,
        :MPO-VAC-HEAD .

:RFID_reader_for_workpiece_identification a :PartSpecification .

:Read_workpiece_data a :Function ;
    :hasFunctionDescription "RFID sensor reads color and identification data from workpiece" ;
    :partTypeInvolvedInFunc :RFID_SCANNER .

:Red_bin_detection_sensor a :PartSpecification .

:Red_ejector_cylinder a :PartSpecification .

:Red_ejector_valve a :PartSpecification .

