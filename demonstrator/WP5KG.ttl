:Control_System_%28Turck_PLC_Setup%29 a :BuildingBlock ;
    :hasPart :HMI-PANEL,
        :IO-ANALOG,
        :IO-DIGITAL,
        :PLC-NET,
        :PLC-TURCK,
        :POWER-24V .

:Cycle_complete a :Function ;
    :hasFunctionDescription "System returns to idle state and is ready for next cycle" ;
    :partTypeInvolvedInFunc :ALL_SYSTEMS .

:Detect_color a :Function ;
    :hasFunctionDescription "Color sensor determines workpiece color" ;
    :partTypeInvolvedInFunc :COLOR_SENSOR .

:Detect_incoming_workpiece a :Function ;
    :hasFunctionDescription "Entry light sensor detects arrival of workpiece" ;
    :partTypeInvolvedInFunc :LIGHT_SENSOR .

:Detect_workpiece a :Function ;
    :hasFunctionDescription "Light sensor confirms presence of workpiece at entry" ;
    :partTypeInvolvedInFunc :LIGHT_SENSOR .

<http://www.semanticweb.org/ydo840/ontologies/2025/1/ZorroOntology#Digital_I/O_module> a :PartSpecification .

:Eject_workpiece a :Function ;
    :hasFunctionDescription "Pneumatic ejector pushes workpiece onto conveyor" ;
    :partTypeInvolvedInFunc :COMPRESSOR,
        :CYLINDER,
        :SOLENOID_VALVE .

:Feed_into_oven a :Function ;
    :hasFunctionDescription "Feeder pushes workpiece into oven and door closes using pneumatic system" ;
    :partTypeInvolvedInFunc :COMPRESSOR,
        :CYLINDER,
        :SOLENOID_VALVE .

:Forward_conveyor_mini_motor a :PartSpecification .

:Furnace_unit a :PartSpecification .

