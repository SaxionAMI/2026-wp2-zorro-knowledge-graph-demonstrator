    :hasFunctionDescription "Robot transports workpiece to RFID platform" ;
    :partTypeInvolvedInFunc :ENCODER_MOTOR .

:Transport_to_output a :Function ;
    :hasFunctionDescription "Conveyor transports workpiece toward sorting line" ;
    :partTypeInvolvedInFunc :CONVEYOR,
        :MINI_MOTOR .

:Transport_to_processing_station_MPO a :Function ;
    :hasFunctionDescription "Robot moves workpiece to MPO input area" ;
