demo:MINI_MOTOR a demo:PartType .

demo:CYLINDER a demo:PartType .

demo:PartType a owl:Class .

zorro:Function a owl:Class ;
    rdfs:comment "A function can be performed by one or several componenets" ;
    owl:disjointWith zorro:Cause,
        zorro:Component,
        zorro:Effect,
        zorro:Problem,
        zorro:Solution .

zorro:Cause a owl:Class ;
    rdfs:comment "Cause itself  is a problem" ;
    owl:disjointWith zorro:Component,
        zorro:Function,
        zorro:Solution .

zorro:Solution a owl:Class ;
    rdfs:comment "Solution solves the cause of the problem" ;
    owl:disjointWith zorro:Cause,
        zorro:Component,
        zorro:Effect,
        zorro:Function,
        zorro:Problem .

zorro:Problem a owl:Class ;
    owl:disjointWith zorro:Component,
        zorro:Function,
        zorro:Solution .

