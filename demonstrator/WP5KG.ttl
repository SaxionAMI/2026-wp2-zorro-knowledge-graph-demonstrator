    :hasPartSpecification :Operator_interface ;
    :hasPartType :HMI .

:Horizontal_encoder_motor a :PartSpecification .

:Horizontal_movement_motor a :PartSpecification .

:Horizontal_position_encoder a :PartSpecification .

:IO-ANALOG a :Part ;
    :hasPartSpecification <http://www.semanticweb.org/ydo840/ontologies/2025/1/ZorroOntology#Analog_I/O_module> ;
    :hasPartType :IO_MODULE .

:IO-DIGITAL a :Part ;
    :hasPartSpecification <http://www.semanticweb.org/ydo840/ontologies/2025/1/ZorroOntology#Digital_I/O_module> ;
    :hasPartType :IO_MODULE .

:Indexing_turntable a :PartSpecification .

:Industrial_Ethernet_switch a :PartSpecification .

:Input_light_barrier a :PartSpecification .

:Inside_light_barrier a :PartSpecification .

:MPO-COMP a :Part ;
    :hasPartSpecification :Pneumatic_supply ;
    :hasPartType :COMPRESSOR .

:MPO-CONV-MOTOR a :Part ;
    :hasPartSpecification :Conveyor_drive_mini_motor ;
    :hasPartType :MINI_MOTOR .

:MPO-CONVEYOR a :Part ;
    :hasPartSpecification :Transport_conveyor ;
    :hasPartType :CONVEYOR .

:MPO-EJECTOR a :Part ;
    :hasPartSpecification :Turntable_ejection_valve ;
    :hasPartType :SOLENOID_VALVE .

:MPO-FEEDER-IN a :Part ;
    :hasPartSpecification :Oven_feeder_inside_cylinder ;
    :hasPartType :CYLINDER .

:MPO-FEEDER-OUT a :Part ;
    :hasPartSpecification :Oven_feeder_outside_cylinder ;
    :hasPartType :CYLINDER .

:MPO-LIGHT-BARRIER a :Part ;
    :hasPartSpecification :Workpiece_detection_sensor ;
    :hasPartType :LIGHT_SENSOR .

:MPO-OVEN a :Part ;
    :hasPartSpecification :Furnace_unit ;
    :hasPartType :KILN .

:MPO-OVEN-DOOR a :Part ;
    :hasPartSpecification :Oven_door_valve ;
    :hasPartType :SOLENOID_VALVE .

:MPO-OVEN-SENSOR a :Part ;
    :hasPartSpecification :Oven_presence_sensor ;
    :hasPartType :LIGHT_SENSOR .

:MPO-SAWWHEEL a :Part ;
    :hasPartSpecification :Saw_or_milling_motor ;
    :hasPartType :MINI_MOTOR .

:MPO-SUCTION a :Part ;
    :hasPartSpecification :Vacuum_suction_cup_%28workpiece_transfer%29 ;
    :hasPartType :SUCTION_CUP .

:MPO-TT-MOTOR a :Part ;
    :hasPartSpecification :Turntable_drive_mini_motor ;
    :hasPartType :MINI_MOTOR .

:MPO-TURNTABLE a :Part ;
    :hasPartSpecification :Indexing_turntable ;
    :hasPartType :ROTARY_TABLE .

:MPO-VAC-HEAD a :Part ;
    :hasPartSpecification :Vacuum_lowering_cylinder ;
    :hasPartType :CYLINDER .

:Machine_workpiece a :Function ;
    :hasFunctionDescription "Saw or milling operation is performed" ;
    :partTypeInvolvedInFunc :MINI_MOTOR .

:Main_industrial_controller a :PartSpecification .

:Move_along_conveyor a :Function ;
    :hasFunctionDescription "Workpiece is transported through sorting section" ;
    :partTypeInvolvedInFunc :CONVEYOR,
        :MINI_MOTOR .

:Move_conveyor_to_pickup_position a :Function ;
    :hasFunctionDescription "Conveyor belt moves carrier to output position where it can be picked up" ;
    :partTypeInvolvedInFunc :CONVEYOR,
        :LIGHT_SENSOR,
        :MINI_MOTOR .

:Move_conveyor_to_storage_position a :Function ;
    :hasFunctionDescription "Conveyor transports workpiece into warehouse system" ;
    :partTypeInvolvedInFunc :CONVEYOR,
        :LIGHT_SENSOR,
        :MINI_MOTOR .

:Move_to_warehouse a :Function ;
    :hasFunctionDescription "Robot moves to warehouse pickup position" ;
    :partTypeInvolvedInFunc :ENCODER_MOTOR,
        :REFERENCE_SWITCH .

