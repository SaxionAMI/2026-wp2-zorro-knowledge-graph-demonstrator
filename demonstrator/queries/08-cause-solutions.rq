PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX : <http://www.semanticweb.org/ydo840/ontologies/2025/1/ZorroOntology#>

select ?solution ?solutionLabel
where {
:cause020 a ?Cause;
:hasSolution ?solution .
?solution rdfs:label ?solutionLabel
}
