<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ontologies/2026/ZorroDemo/"
     xml:base="http://www.semanticweb.org/ontologies/2026/ZorroDemo/"
     xmlns:zorro="http://w3id.org/ZorroOntology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/2026/ZorroDemo/">
    <owl:imports rdf:resource="http://w3id.org/ZorroOntology/"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/ZorroDemo/inSubsystem">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Assembly"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/ZorroDemo/SubSystem"/>
    </owl:ObjectProperty>
    

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/ZorroDemo/hasPartSpecification">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Part"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/ZorroDemo/PartSpecification"/>
    </owl:ObjectProperty>



    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/ZorroDemo/partTypeInvolvedInFunc">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Function"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/ZorroDemo/PartType"/>
    </owl:ObjectProperty>
    

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/ZorroDemo/hasPartType">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Part"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/ZorroDemo/PartType"/>
    </owl:ObjectProperty>
    

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/ZorroDemo/hasSolution">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Cause"/>
        <rdfs:range rdf:resource="http://w3id.org/ZorroOntology/Solution"/>
    </owl:ObjectProperty>



    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/ZorroDemo/hasFunctionDescription">
        <rdfs:domain rdf:resource="http://w3id.org/ZorroOntology/Function"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>




    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/ZorroDemo/SubSystem"/>
        

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/ZorroDemo/PartSpecification"/>
    

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/ZorroDemo/PartType"/>

</rdf:RDF>



